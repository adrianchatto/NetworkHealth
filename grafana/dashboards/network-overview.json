{
  "__inputs": [
    {
      "name": "DS_INFLUXDB",
      "label": "InfluxDB-UniFi",
      "description": "InfluxDB v2 Flux data source",
      "type": "datasource",
      "pluginId": "influxdb",
      "pluginName": "InfluxDB"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "influxdb", "name": "InfluxDB", "version": "1.0.0" },
    { "type": "grafana",    "id": "grafana",  "name": "Grafana",  "version": "9.0.0" }
  ],
  "id": null,
  "uid": "unifi-network-overview",
  "title": "UniFi — Network Overview",
  "tags": ["unifi", "network"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "WiFi Clients (now)",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"green","value":null},{"color":"yellow","value":20},{"color":"red","value":40}] } } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"network_summary\" and r._field == \"wifi_clients\")\n  |> last()"
      }]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "APs Online",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":null},{"color":"green","value":1}] } } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"network_summary\" and r._field == \"aps_online\")\n  |> last()"
      }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "Avg WiFi Satisfaction",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":null},{"color":"yellow","value":60},{"color":"green","value":80}] } } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"wifi_client\" and r._field == \"satisfaction\")\n  |> mean()"
      }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "Avg RSSI (dBm)",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "dBm", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color":"red","value":null},{"color":"yellow","value":-75},{"color":"green","value":-65}] } } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"wifi_client\" and r._field == \"rssi\")\n  |> mean()"
      }]
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "WiFi Client Count Over Time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 }, "color": { "mode": "palette-classic" } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_summary\" and r._field == \"wifi_clients\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
      }]
    },

    {
      "id": 11,
      "type": "timeseries",
      "title": "Channel Utilisation per AP Radio",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "lineWidth": 2 }, "min": 0, "max": 100 }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ap_radio\" and r._field == \"channel_utilization\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
      }]
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Client RSSI Distribution (all WiFi clients)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "unit": "dBm", "custom": { "lineWidth": 1, "fillOpacity": 5 }, "thresholds": { "steps": [{"color":"red","value":null},{"color":"yellow","value":-75},{"color":"green","value":-65}] } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean","min"] } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"wifi_client\" and r._field == \"rssi\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
      }]
    },

    {
      "id": 21,
      "type": "timeseries",
      "title": "AP TX Retries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2 } }
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean","max"] } },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"ap_radio\" and r._field == \"tx_retries\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
      }]
    },

    {
      "id": 30,
      "type": "table",
      "title": "Current WiFi Clients",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "sortBy": [{ "displayName": "rssi", "desc": false }] },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: -10m)\n  |> filter(fn: (r) => r._measurement == \"wifi_client\" and (r._field == \"rssi\" or r._field == \"satisfaction\" or r._field == \"tx_rate\" or r._field == \"rx_rate\" or r._field == \"snr\"))\n  |> last()\n  |> pivot(rowKey: [\"_time\", \"hostname\", \"ap_mac\", \"channel\", \"radio\", \"essid\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> keep(columns: [\"hostname\", \"rssi\", \"snr\", \"satisfaction\", \"tx_rate\", \"rx_rate\", \"ap_mac\", \"channel\", \"radio\", \"essid\"])"
      }]
    },

    {
      "id": 40,
      "type": "logs",
      "title": "Recent Network Events",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
      "options": { "dedupStrategy": "none", "showTime": true, "sortOrder": "Descending" },
      "targets": [{
        "refId": "A",
        "query": "from(bucket: \"unifi\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"network_event\" and r._field == \"message\")\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 200)"
      }]
    }

  ]
}
