# ── UniFi Controller ──────────────────────────────────────────────────────────
UNIFI_HOST=https://192.168.1.1
UNIFI_USER=your-admin-username
UNIFI_PASS=your-admin-password
UNIFI_SITE=default
UNIFI_VERIFY_SSL=false

# ── InfluxDB ──────────────────────────────────────────────────────────────────
# Password for the InfluxDB admin account (choose something strong)
INFLUXDB_PASSWORD=changeme-strong-password

# Token used by the collector to write data — must match INFLUXDB_INIT_ADMIN_TOKEN
INFLUXDB_TOKEN=changeme-long-random-token

# ── Grafana ───────────────────────────────────────────────────────────────────
# Only needed if you're adding a fresh Grafana alongside InfluxDB.
# If you already have Grafana running, leave these and skip the grafana service.
GF_SECURITY_ADMIN_PASSWORD=changeme-grafana-password
